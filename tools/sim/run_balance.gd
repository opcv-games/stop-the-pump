extends SceneTree
## Runs every bot strategy through the same seeded runs and writes docs/balance/REPORT.md and
## docs/balance/results.csv (#6). Every strategy sees the same seeds, so differences are the
## strategy's, not luck's.
##
##     godot --headless -s tools/sim/run_balance.gd -- 5000        (runs per strategy; default 2000)
##     godot --headless -s tools/sim/run_balance.gd -- 5000 sweep  (also tries rent and fuel-price levers)

const REPORT := "res://docs/balance/REPORT.md"
const CSV := "res://docs/balance/results.csv"


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	var runs := int(args[0]) if args.size() > 0 else 2000
	var started := Time.get_ticks_msec()
	var rows: Array[Dictionary] = []
	var sweep := "sweep" in args
	var csv := ["strategy,seed,evicted,complete,days,cash,stops,pumps,self_pumps,xp,ran_dry_days"]
	for id in BalanceSim.STRATEGIES:
		var strat := BalanceSim.strategy(id)
		var results: Array[Dictionary] = []
		for seed in runs:
			var st := SimStation.from_game_defaults()
			st.rng.seed = seed + 1
			var r := BalanceSim.play_run(strat, st)
			st.free()
			results.append(r)
			csv.append("%s,%d,%s,%s,%d,%.2f,%d,%d,%d,%d,%d" % [id, seed + 1, r.evicted, r.complete, r.days,
				r.cash, r.stops, r.pumps, r.self_pumps, r.xp, r.ran_dry_days])
		rows.append(_summarise(strat, results))
		print("%-34s survive %5.1f%%   median cash $%7.0f" % [strat.label, rows[-1].survival * 100.0, rows[-1].median_cash])
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return a.survival > b.survival or (a.survival == b.survival and a.median_cash > b.median_cash))
	_write(CSV, "\n".join(csv) + "\n")
	var text := _report(rows, runs)
	if sweep:
		text += _sweep(rows[0].id, runs)
	_write(REPORT, text)
	print("%d runs in %.1f s -> %s" % [runs * BalanceSim.STRATEGIES.size(), (Time.get_ticks_msec() - started) / 1000.0, REPORT])
	quit()


func _summarise(strat: Dictionary, results: Array[Dictionary]) -> Dictionary:
	var survived := 0
	var cash: Array[float] = []
	var evict_days := {}
	var day_cash := []  # mean cash after each day, over runs still going
	var day_n := []
	var stops := 0.0
	var days := 0.0
	var pumps := 0.0
	var self_pumps := 0.0
	var dry := 0.0
	for r in results:
		if r.complete:
			survived += 1
		else:
			evict_days[r.days] = evict_days.get(r.days, 0) + 1
		cash.append(r.cash)
		stops += r.stops
		days += r.days
		pumps += r.pumps
		self_pumps += r.self_pumps
		dry += r.ran_dry_days
		for d in r.history.size():
			if day_cash.size() <= d:
				day_cash.append(0.0)
				day_n.append(0)
			day_cash[d] += r.history[d]
			day_n[d] += 1
	cash.sort()
	var n := float(results.size())
	var curve := []
	for d in day_cash.size():
		curve.append(day_cash[d] / maxf(day_n[d], 1.0))
	var worst_day := -1
	var worst := 0
	for d in evict_days:
		if evict_days[d] > worst:
			worst = evict_days[d]
			worst_day = d
	return {"id": strat.id, "label": strat.label, "survival": survived / n, "median_cash": cash[int(n * 0.5)],
		"p10": cash[int(n * 0.1)], "p90": cash[int(n * 0.9)], "cars_per_day": stops / maxf(days, 1.0),
		"pumps": pumps / n, "self_pumps": self_pumps / n, "dry_days": dry / n, "curve": curve,
		"evict_peak": worst_day}


func _report(rows: Array[Dictionary], runs: int) -> String:
	var st := SimStation.from_game_defaults()
	var lines := [
		"# Balance report",
		"",
		"Generated by `tools/sim/run_balance.gd` (#6): %d seeded runs per strategy, %d days each, same seeds for every strategy." % [runs, st.run_days],
		"",
		"**The bot:** lands Super Perfect, Perfect, Good, OK and Miss equally often (20%% each; a Miss lands $%.2f–$%.2f off, over or under at random). It starts a pour %.1f s after a car parks, plus up to %.1f s per other hand-played pump. Cars take %.1f s to drive in." % [
			st.tiers.ok_window + 0.01, BalanceSim.MISS_REACH, st.reaction_seconds, st.attention_penalty, st.drive_in_seconds],
		"**The game:** today's numbers: %d starting pump, $%.0f starting cash, rent $%.0f + $%.0f a day, a %.0f L tank, fuel %.0f%% of the pump price wholesale." % [
			st.pumps.size(), st.starting_cash, st.economy.rent_base, st.economy.rent_growth, st.tank.capacity_liters, st.economy.wholesale_ratio * 100.0],
		"",
		"## Ranking",
		"",
		"| # | Strategy | Survive 10 days | Median cash at the end | Bottom 10% / top 10% | Cars a day | Pumps (self-serve) | Days the tank ran dry | Most evictions on |",
		"|---|---|---|---|---|---|---|---|---|",
	]
	for i in rows.size():
		var r: Dictionary = rows[i]
		lines.append("| %d | %s | %.1f%% | $%.0f | $%.0f / $%.0f | %.1f | %.1f (%.1f) | %.1f | %s |" % [
			i + 1, r.label, r.survival * 100.0, r.median_cash, r.p10, r.p90, r.cars_per_day, r.pumps, r.self_pumps,
			r.dry_days, ("day %d" % r.evict_peak) if r.evict_peak > 0 else "—"])
	lines += ["", "## Average cash after each day's rent (runs still going)", "",
		"| Strategy | " + " | ".join(range(1, st.run_days + 1).map(func(d: int) -> String: return "D%d" % d)) + " |",
		"|---|" + "---|".repeat(st.run_days)]
	for r in rows:
		var cells := []
		for d in st.run_days:
			cells.append("$%.0f" % r.curve[d] if d < r.curve.size() else "—")
		lines.append("| %s | %s |" % [r.label, " | ".join(cells)])
	st.free()
	lines += ["", "_Raw runs: `docs/balance/results.csv`._", ""]
	return "\n".join(lines)


## Which economy lever fixes survival? The top strategy replays the same seeds under each change.
const LEVERS := [
	{"label": "Today's numbers", "set": {}},
	{"label": "Rent grows $30 a day (not $40)", "set": {"rent_growth": 30.0}},
	{"label": "Rent grows $20 a day", "set": {"rent_growth": 20.0}},
	{"label": "Wholesale fuel 70% of pump price (not 80%)", "set": {"wholesale_ratio": 0.7}},
	{"label": "Wholesale 70% and rent +$30 a day", "set": {"wholesale_ratio": 0.7, "rent_growth": 30.0}},
	{"label": "Tips doubled", "set": {"tips_x2": true}},
	{"label": "Self-serve at 75% speed (not 50%)", "set": {"self_service_speed": 0.75}},
]


func _sweep(best: String, runs: int) -> String:
	var lines := ["", "## Levers (each strategy replayed under one change, %d runs each)" % runs, "",
		"Survival rate of every strategy when one number changes. Best per row in bold.", ""]
	var ids := BalanceSim.STRATEGIES.keys()
	lines.append("| Change | " + " | ".join(ids.map(func(id: String) -> String: return BalanceSim.STRATEGIES[id].label)) + " |")
	lines.append("|---|" + "---|".repeat(ids.size()))
	for lever in LEVERS:
		var cells := []
		var rates := []
		for id in ids:
			var ok := 0
			for seed in runs:
				var st := SimStation.from_game_defaults()
				st.rng.seed = seed + 1
				for key in lever.set:
					match key:
						"rent_growth", "wholesale_ratio":
							st.economy.set(key, lever.set[key])
						"tips_x2":
							for t in ["super_perfect_tip", "perfect_tip", "good_tip"]:
								st.economy.set(t, st.economy.get(t) * 2.0)
						_:
							st.set(key, lever.set[key])
				if BalanceSim.play_run(BalanceSim.strategy(id), st).complete:
					ok += 1
				st.free()
			rates.append(float(ok) / runs)
		var top: float = rates.max()
		for r in rates:
			cells.append(("**%.0f%%**" if r == top and top > 0.0 else "%.0f%%") % (r * 100.0))
		lines.append("| %s | %s |" % [lever.label, " | ".join(cells)])
		print("lever: %s done" % lever.label)
	return "\n".join(lines) + "\n"


func _write(path: String, text: String) -> void:
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(text)
	f.close()
